# Copy to .env and replace both values with independently generated secrets.
POSTGRES_PASSWORD=replace-with-long-random-password
SESSION_SECRET=replace-with-long-random-secret

# Optional local Ollama fallback. Leave blank to disable.
# Docker Desktop can resolve host.docker.internal to reach a host service.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3-vl:4b
OLLAMA_TIMEOUT_SECONDS=120
